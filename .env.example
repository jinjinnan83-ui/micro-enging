# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=psychoanalysis
QDRANT_API_KEY=

# Embeddings: BGE large Chinese
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DIM=1024

# Reranker: BGE reranker
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Chunking (keep psychoanalytic metaphor and concept density)
CHUNK_SIZE=512
CHUNK_OVERLAP=80

# Hybrid retrieval: dense + BM25 → Top-20 → BGE rerank 3-5
DENSE_TOP_K=20
BM25_TOP_K=20
HYBRID_CANDIDATE_K=20
RERANK_TOP_N=5
HYBRID_FUSION_WEIGHT=0.6

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info

# Optional LLM for answer synthesis (leave empty for retrieval-only)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Psychodynamic dialogue agent (DeepSeek Chat Completions)
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_THINKING_TYPE=disabled
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
